@model Static_and_Login.Models.LoginViewModel

@{
    ViewBag.Title = "Login";
}

<section class="section section-light" style="padding-top: 130px;">
    <div class="container">

        <div class="section-heading">
            <p>WELCOME BACK</p>
            <h2>Login to Your Account</h2>
            <div class="heading-line"></div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-5">

                <div class="contact-card text-start">

                    @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3 d-block" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Username, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3 text-end">
                            <a href="@Url.Action("ForgotPassword", "Account")" style="color:#0757a0; font-size:0.9rem;">Forgot password?</a>
                        </div>

                        <div class="mb-3 form-check">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label" })
                        </div>
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary-custom">
                                Log In
                            </button>
                        </div>

                        <p class="text-center mt-3 mb-0" style="color:#62748a;">
                            Don't have an account?
                            <a href="@Url.Action("Register", "Account")" style="color:#0757a0; font-weight:600;">Register here</a>
                        </p>
                    }

                </div>

            </div>
        </div>

    </div>
</section>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

