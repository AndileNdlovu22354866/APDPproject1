
@model Static_and_Login.Models.RegisterViewModel

@{
    ViewBag.Title = "Register";
}

<section class="section section-light" style="padding-top: 130px;">
    <div class="container">

        <div class="section-heading">
            <p>JOIN US</p>
            <h2>Create Your Account</h2>
            <div class="heading-line"></div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="contact-card text-start">

                    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3 d-block" })

                        <div class="row g-3">

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Name, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Surname, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.Surname, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Surname, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Username, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.CellNumber, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.CellNumber, new { @class = "form-control", placeholder = "0821234567" })
                                @Html.ValidationMessageFor(m => m.CellNumber, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.DateOfBirth, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-12">
                                @Html.LabelFor(m => m.HomeAddress, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.HomeAddress, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.HomeAddress, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Town, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.Town, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Town, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Province, new { @class = "form-label fw-semibold" })
                                @Html.DropDownListFor(m => m.Province, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "-- Select Province --", Value = "" },
                                    new SelectListItem { Text = "Eastern Cape", Value = "Eastern Cape" },
                                    new SelectListItem { Text = "Free State", Value = "Free State" },
                                    new SelectListItem { Text = "Gauteng", Value = "Gauteng" },
                                    new SelectListItem { Text = "KwaZulu-Natal", Value = "KwaZulu-Natal" },
                                    new SelectListItem { Text = "Limpopo", Value = "Limpopo" },
                                    new SelectListItem { Text = "Mpumalanga", Value = "Mpumalanga" },
                                    new SelectListItem { Text = "North West", Value = "North West" },
                                    new SelectListItem { Text = "Northern Cape", Value = "Northern Cape" },
                                    new SelectListItem { Text = "Western Cape", Value = "Western Cape" }
                                }, new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.Province, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Gender, new { @class = "form-label fw-semibold" })
                                @Html.DropDownListFor(m => m.Gender, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "-- Select --", Value = "" },
                                    new SelectListItem { Text = "Boy", Value = "Boy" },
                                    new SelectListItem { Text = "Girl", Value = "Girl" },
                                    new SelectListItem { Text = "Other", Value = "Other" }
                                }, new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold" })
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-semibold" })
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                            </div>

                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary-custom">
                                Create Account
                            </button>
                        </div>

                        <p class="text-center mt-3 mb-0" style="color:#62748a;">
                            Already have an account?
                            <a href="@Url.Action("Login", "Account")" style="color:#0757a0; font-weight:600;">Log in</a>
                        </p>
                    }

                </div>

            </div>
        </div>

    </div>
</section>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

