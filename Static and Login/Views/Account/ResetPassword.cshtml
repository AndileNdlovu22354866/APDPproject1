@model Static_and_Login.Models.ResetPasswordViewModel

@{
    ViewBag.Title = "Reset Password";
}

<section class="section section-light" style="padding-top: 130px;">
    <div class="container">

        <div class="section-heading">
            <p>ACCOUNT RECOVERY</p>
            <h2>Enter Your Code</h2>
            <div class="heading-line"></div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-5">

                <div class="contact-card text-start">

                    <p class="mb-4" style="color:#62748a;">
                        We've sent a 6-digit code to <strong>@Model.Email</strong>.
                        Enter it below along with your new password.
                    </p>

                    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Email)
                        @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3 d-block" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.OtpCode, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.OtpCode, new { @class = "form-control", maxlength = "6", placeholder = "123456" })
                            @Html.ValidationMessageFor(m => m.OtpCode, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.NewPassword, new { @class = "form-label fw-semibold" })
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-semibold" })
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary-custom">
                                Reset Password
                            </button>
                        </div>
                    }

                </div>

            </div>
        </div>

    </div>
</section>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

